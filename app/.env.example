# ---------------------------------------------------------------------------
# Salesforce Headless 360 demo - environment configuration
# Copy this file to ".env" and fill in values from your org's
# External Client App (see docs/SETUP.md). Never commit the real .env.
# ---------------------------------------------------------------------------

# Server
PORT=3000

# When true (or when SF_CLIENT_ID is empty) the app serves canned data so the
# UI is fully demoable WITHOUT a Salesforce org. Set to false once configured.
MOCK_MODE=true

# --- Salesforce org / OAuth (client credentials flow) ----------------------
# Your org's My Domain login host, e.g. https://my-company.my.salesforce.com
SF_LOGIN_URL=
# Consumer Key / Secret from the External Client App (OAuth client credentials)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Salesforce REST API version used for data calls
SF_API_VERSION=64.0

# --- Agentforce Agent API --------------------------------------------------
# The 18-char Agent (Bot) Id of the agent you built in Agentforce Builder
SF_AGENT_ID=
# Agent API host (rarely needs changing)
SF_AGENT_API_BASE=https://api.salesforce.com
